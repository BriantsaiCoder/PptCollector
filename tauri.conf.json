{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PptCollector",
  "version": "0.2.2",
  "identifier": "io.pptcollector.desktop",
  "build": {
    "frontendDist": "./web",
    "beforeBuildCommand": "node scripts/build-engine.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "PptCollector",
      "width": 1120,
      "height": 780,
      "minWidth": 620,
      "minHeight": 520
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": [{
        "identifier": "main",
        "windows": ["main"],
        "permissions": ["core:event:allow-listen", "core:event:allow-unlisten"]
      }]
    }
  },
  "bundle": {
    "active": true,
    "resources": { "engine/publish/": "engine/" },
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
